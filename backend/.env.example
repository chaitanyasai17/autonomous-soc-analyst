APP_NAME="ASOC — Autonomous SOC Analyst"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-locally
ADMIN_ROLE=super_admin

DATABASE_URL=sqlite:///./asoc.db

AI_PROVIDER=heuristic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

UPLOAD_DIRECTORY=uploads/security_logs
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=["csv","json","log","txt"]

SIGMA_RULES_DIRECTORY=sigma_rules
