# ==============================================================================
# Autonomous SOC Analyst — Root Environment Variable Template
# Copy to .env and adjust credentials as appropriate for your environment
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME=Autonomous SOC Analyst
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite for local developer zero-dependency execution:
DATABASE_URL=sqlite:///./asoc.db
# PostgreSQL for Docker / Production staging:
# DATABASE_URL=postgresql://asoc_user:asoc_secure_password_123!@localhost:5432/asoc_db

# Artificial Intelligence Threat Engine
# Options: heuristic (built-in offline resilient), ollama (local LLM), openai (cloud LLM)
AI_PROVIDER=heuristic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SOC Risk Engine Thresholds
ALERT_GENERATION_THRESHOLD=50.0
CRITICAL_RISK_THRESHOLD=80.0
HIGH_RISK_THRESHOLD=60.0
MEDIUM_RISK_THRESHOLD=40.0

# Storage Locations
STORAGE_LOGS_DIR=storage/logs
STORAGE_REPORTS_DIR=storage/reports
STORAGE_RULES_DIR=storage/rules

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:80", "http://127.0.0.1:5173"]
